# Copy to .env — every value is optional. Keys can also be set in the app (Settings).
# Keys in .env never leave this machine except to the provider they belong to.

# --- AI model (any one is enough; the first one found becomes the default) --------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Override the default models picked for an env provider
# DIRECTOR_MODEL=gpt-5
# DIRECTOR_FAST_MODEL=gpt-5-mini

# --- Voice & transcription ----------------------------------------------------------
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# --- Stock media, research ------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- System -----------------------------------------------------------------------------
# PORT=3333
# HOST=127.0.0.1
# DIRECTOR_DATA_DIR=/path/to/data          # where projects, media and settings live
# FFMPEG_PATH=/usr/local/bin/ffmpeg        # use a specific FFmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
# DIRECTOR_BROWSER=/path/to/chrome         # render with an installed Chrome/Chromium
# DIRECTOR_NO_WARMUP=1                     # skip pre-bundling the composition at startup
