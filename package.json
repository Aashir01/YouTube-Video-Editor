{
  "name": "director-studio",
  "version": "1.0.0",
  "description": "Agentic, LLM-powered video editor for YouTube: edit your footage or generate motion-graphics videos from a topic, with any LLM (OpenAI-compatible, Gemini, Claude) and an MCP server.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "director": "./bin/director.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'data/**' --ignore 'src/web/**' src/server/main.ts --dev",
    "build": "vite build",
    "start": "node bin/director.mjs start",
    "mcp": "node bin/director.mjs mcp",
    "doctor": "node bin/director.mjs doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remotion/bundler": "4.0.537",
    "@remotion/captions": "4.0.537",
    "@remotion/install-whisper-cpp": "4.0.537",
    "@remotion/layout-utils": "4.0.537",
    "@remotion/media-utils": "4.0.537",
    "@remotion/noise": "4.0.537",
    "@remotion/paths": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@remotion/shapes": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "nanoid": "^5.1.6",
    "openai": "^7.41.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remotion": "4.0.537",
    "sonner": "^2.0.8",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
