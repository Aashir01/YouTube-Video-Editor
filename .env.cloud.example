# Copy to .env.cloud for `npm run cloud` (Cutroom Cloud: accounts, credits and the AI gateway).
# Kept apart from .env on purpose: this key pays for every user's AI requests.

# --- Upstream (required) ---------------------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Admin (required for grants, plans and manual payments) -----------------------------
# A long random string: openssl rand -hex 32
ADMIN_TOKEN=

# --- Server -------------------------------------------------------------------------------
# CLOUD_PORT=8787
# CLOUD_HOST=0.0.0.0
# CLOUD_DB=/var/lib/cutroom/cloud.db
# TRUST_PROXY=1                      # behind nginx/Caddy/Cloudflare: client IPs from X-Forwarded-For
# CLOUD_MODELS=/etc/cutroom/models.json   # replace the built-in model catalog

# --- Credits and plans ---------------------------------------------------------------------
# CREDIT_USD=0.001                   # one credit = this much upstream cost (before the markup)
# CLOUD_MARKUP=1.15                  # covers the upstream fee, payment fees and free credits
# SIGNUP_CREDITS=300
# FREE_MONTHLY_CREDITS=50
# CREATOR_MONTHLY_CREDITS=2000
# SIGNUPS_PER_IP_PER_DAY=3
# CLOUD_MAX_CONCURRENT=4

# --- Invites ---------------------------------------------------------------------------------------
# REFERRAL_INVITEE_CREDITS=100       # extra gift for joining with an invite code
# REFERRAL_ACTIVE_CREDITS=300        # for the inviter once the friend has used REFERRAL_ACTIVE_AFTER credits
# REFERRAL_ACTIVE_AFTER=100
# REFERRAL_PURCHASE_CREDITS=1000     # for the inviter on the friend's first purchase
# REFERRAL_MONTHLY_CAP=10            # most activity rewards an inviter gets a month

# --- Payments ---------------------------------------------------------------------------------
# Until checkout links exist, people ask here and you apply payments with /v1/admin/purchase
# CONTACT_URL=https://wa.me/92XXXXXXXXXX
# Checkout links per product (Paddle, Polar, Lemon Squeezy...); the app adds ?email=
# CHECKOUT_URL_CREATOR_MONTH=
# CHECKOUT_URL_CREATOR_QUARTER=
# CHECKOUT_URL_CREATOR_YEAR=
# CHECKOUT_URL_PACK_5=
# CHECKOUT_URL_PACK_10=
# CHECKOUT_URL_PACK_20=
